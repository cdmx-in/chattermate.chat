{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": false,
    "baseUrl": ".",
    "paths": {
      "@e2e": ["./src/index.ts"],
      "@e2e/*": ["./src/*"]
    }
  },
  "include": ["playwright.config.ts", "src/**/*.ts", "specs/**/*.ts", "services/**/*.ts"]
}
